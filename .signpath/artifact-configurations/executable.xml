<?xml version="1.0" encoding="utf-8"?>
<!-- Configuração "executable" no SignPath: o nexo.exe, antes de entrar nos instaladores. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="nexo.exe" product-name="Nexo" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
