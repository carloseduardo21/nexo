{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexo",
  "version": "0.3.0",
  "identifier": "dev.nexo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexo",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "decorations": false,
        "backgroundColor": "#0f1320",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Carlos Silva",
    "copyright": "Copyright (C) 2026 Carlos Silva. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/carloseduardo21/nexo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMDlBQkU1NzZENDY2QzkKUldUSlp0UjI1YXNKUHNwQmNWYjgwc2d5WDNtMFQraDFBcnBEQ0V4U0hFdVVFZCt4M0JGdlQxaksK",
      "endpoints": ["https://github.com/carloseduardo21/nexo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
